<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Rillet Partnerships: Revenue Dashboard</title>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      background: #0a0d14;
      color: #e2e8f0;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      min-height: 100vh;
      padding: 32px;
    }
    .header {
      display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 36px;
    }
    .header-left h1 { font-size: 26px; font-weight: 700; letter-spacing: -0.5px; color: #f8fafc; }
    .header-left p  { font-size: 13px; color: #64748b; margin-top: 4px; }
    .badge {
      display: inline-flex; align-items: center; gap: 6px;
      background: rgba(99,102,241,0.15); border: 1px solid rgba(99,102,241,0.3);
      color: #a5b4fc; font-size: 11px; font-weight: 600; letter-spacing: 0.5px;
      text-transform: uppercase; padding: 5px 10px; border-radius: 20px; margin-top: 4px;
    }
    .badge::before {
      content: ''; width: 6px; height: 6px; border-radius: 50%;
      background: #6366f1; animation: pulse 2s infinite;
    }
    @keyframes pulse { 0%,100% { opacity:1; } 50% { opacity:0.4; } }

    .kpi-row {
      display: grid; grid-template-columns: repeat(5,1fr); gap: 16px; margin-bottom: 24px;
    }
    .kpi-card {
      background: #111827; border: 1px solid #1e293b; border-radius: 14px;
      padding: 20px 22px; position: relative; overflow: hidden;
    }
    .kpi-card::before {
      content: ''; position: absolute; top:0; left:0; right:0; height: 2px;
      background: var(--accent);
    }
    .kpi-card .label { font-size:11px; font-weight:600; letter-spacing:0.6px; text-transform:uppercase; color:#64748b; margin-bottom:10px; }
    .kpi-card .value { font-size:28px; font-weight:800; letter-spacing:-1px; color:#f1f5f9; line-height:1; }
    .kpi-card .sub   { font-size:12px; color:#475569; margin-top:6px; }

    .chart-card {
      background: #111827; border: 1px solid #1e293b; border-radius: 16px;
      padding: 28px; margin-bottom: 24px;
    }
    .chart-header {
      display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 24px;
    }
    .chart-title    { font-size:15px; font-weight:700; color:#f1f5f9; letter-spacing:-0.2px; }
    .chart-subtitle { font-size:12px; color:#475569; margin-top:3px; }
    .legend-row  { display:flex; gap:16px; align-items:center; }
    .legend-item { display:flex; align-items:center; gap:6px; font-size:12px; color:#94a3b8; }
    .legend-dot  { width:8px; height:8px; border-radius:50%; }
    .chart-wrap  { position:relative; height:320px; }

    table { width:100%; border-collapse:collapse; font-size:13px; }
    th {
      text-align:left; font-size:11px; font-weight:600; letter-spacing:0.5px;
      text-transform:uppercase; color:#475569; padding:0 12px 12px; border-bottom:1px solid #1e293b;
    }
    td { padding:11px 12px; color:#cbd5e1; border-bottom:1px solid #0f172a; }
    tr:last-child td { border-bottom:none; }
    tr:hover td { background:rgba(255,255,255,0.02); }
    td.num { text-align:right; font-variant-numeric:tabular-nums; }

    /* Shared toggle button style */
    .toggle-btn {
      background: transparent; border: 1px solid #1e293b; color: #475569;
      font-size: 10px; font-weight: 600; padding: 3px 8px; border-radius: 6px;
      cursor: pointer; letter-spacing: 0.3px; transition: all 0.15s;
    }
    .toggle-btn.active {
      background: rgba(99,102,241,0.2); border-color: rgba(99,102,241,0.5); color: #a5b4fc;
    }
    .toggle-btn:hover:not(.active) { border-color: #334155; color: #94a3b8; }

    .footer { text-align:center; font-size:11px; color:#334155; margin-top:24px; }

    /* ── Tab nav ───────────────────────────── */
    .tab-nav {
      position: sticky; top: 0; z-index: 100;
      background: rgba(10,13,20,0.92);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid #1e293b;
      display: flex; gap: 0; padding: 0 2px;
      margin: 0 -32px 28px; /* bleed to body edges */
      padding-left: 32px;
    }
    .tab-btn {
      background: transparent; border: none; border-bottom: 2px solid transparent;
      color: #475569; font-size: 12px; font-weight: 600; letter-spacing: 0.2px;
      padding: 13px 18px 11px; cursor: pointer;
      transition: color .15s, border-color .15s;
      white-space: nowrap;
    }
    .tab-btn:hover { color: #94a3b8; }
    .tab-btn.active { color: #a5b4fc; border-bottom-color: #6366f1; }

    /* give each section scroll clearance so sticky nav doesn't overlap */
    .dash-section { scroll-margin-top: 52px; }
  </style>
</head>
<body>

<div class="header">
  <div class="header-left">
    <h1>Rillet Partnerships: Revenue Dashboard</h1>
    <p>Closed Won · Lead Source: Inbound - Partner &amp; Partner - Resell</p>
  </div>
  <div style="text-align:right">
    <div class="badge">Live · Salesforce</div>
    <div style="font-size:11px;color:#334155;margin-top:6px;">Updated May 2026</div>
  </div>
</div>

<!-- Tab Nav -->
<nav class="tab-nav" id="dashTabs">
  <button class="tab-btn active" data-target="sec-overview">Revenue &amp; Overview</button>
  <button class="tab-btn" data-target="sec-pipeline">Pipeline Generation</button>
  <button class="tab-btn" data-target="sec-performance">Detailed Performance</button>
  <button class="tab-btn" data-target="sec-partners">Partners</button>
  <button class="tab-btn" data-target="sec-deals">Deal Detail</button>
</nav>

<!-- KPI Row -->
<div id="sec-overview" class="dash-section">
<div class="kpi-row">
  <div class="kpi-card" style="--accent:linear-gradient(90deg,#6366f1,#8b5cf6)">
    <div class="label">Revenue MTD</div>
    <div class="value">$153.9K</div>
    <div class="sub">5 deals · May 2026</div>
  </div>
  <div class="kpi-card" style="--accent:linear-gradient(90deg,#10b981,#06b6d4)">
    <div class="label">Revenue YTD</div>
    <div class="value">$592.9K</div>
    <div class="sub">29 deals · Jan – May 2026</div>
  </div>
  <div class="kpi-card" style="--accent:linear-gradient(90deg,#f59e0b,#f97316)">
    <div class="label">New Pipeline MTD</div>
    <div class="value">$920K</div>
    <div class="sub">30 open opps · May 2026</div>
  </div>
  <div class="kpi-card" style="--accent:linear-gradient(90deg,#06b6d4,#6366f1)">
    <div class="label">Partner YTD cARR</div>
    <div class="value">$593K</div>
    <div class="sub">$592,850 closed won · Jan–May 2026</div>
  </div>
  <div class="kpi-card" style="--accent:linear-gradient(90deg,#10b981,#06b6d4)">
    <div class="label">Active Last 30 Days</div>
    <div class="value">32%</div>
    <div class="sub">32 of 100 partners sent deals</div>
  </div>
</div>

<!-- Line Chart + Partner Type Table -->
<div style="display:grid;grid-template-columns:1fr 340px;gap:16px;margin-bottom:24px;">

  <div class="chart-card" style="margin-bottom:0">
    <div class="chart-header">
      <div>
        <div class="chart-title">Monthly Partner ARR — Closed Won</div>
        <div class="chart-subtitle">ARR from partner-sourced opportunities, by close month</div>
      </div>
      <div class="legend-row">
        <div class="legend-item"><div class="legend-dot" style="background:#6366f1"></div>ARR</div>
      </div>
    </div>
    <div class="chart-wrap"><canvas id="mainChart"></canvas></div>
  </div>

  <div class="chart-card" style="margin-bottom:0">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;">
      <div class="chart-title">ARR by Partner Type</div>
      <div id="typeToggle" style="display:flex;gap:4px;flex-wrap:wrap;justify-content:flex-end;"></div>
    </div>
    <table>
      <thead><tr><th>Type</th><th style="text-align:right">ARR</th><th style="text-align:right">Deals</th></tr></thead>
      <tbody id="typeTableBody"></tbody>
    </table>
    <div style="margin-top:20px">
      <div style="font-size:11px;color:#475569;margin-bottom:10px;font-weight:600;letter-spacing:0.4px;text-transform:uppercase;">Share of ARR</div>
      <div id="shareBars"></div>
    </div>
  </div>

</div>

</div><!-- /sec-overview -->

<!-- ══ PIPELINE ══════════════════════════════ -->
<div id="sec-pipeline" class="dash-section">
<div style="margin:0 0 16px">
  <div style="font-size:13px;font-weight:700;color:#64748b;letter-spacing:1px;text-transform:uppercase;">All Partner Pipeline Generated</div>
  <div style="height:1px;background:#1e293b;margin-top:8px"></div>
</div>

<div style="display:grid;grid-template-columns:1fr 340px;gap:16px;margin-bottom:24px;">

  <div class="chart-card" style="margin-bottom:0">
    <div class="chart-header">
      <div>
        <div class="chart-title">Monthly Partner Pipeline ARR</div>
        <div class="chart-subtitle">All opportunities created by partner lead source · by month</div>
      </div>
      <div class="legend-row">
        <div class="legend-item"><div class="legend-dot" style="background:#10b981"></div>Pipeline ARR</div>
      </div>
    </div>
    <div class="chart-wrap"><canvas id="pipelineChart"></canvas></div>
  </div>

  <div class="chart-card" style="margin-bottom:0">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;">
      <div class="chart-title">Pipeline ARR by Partner Type</div>
      <div id="plTypeToggle" style="display:flex;gap:4px;flex-wrap:wrap;justify-content:flex-end;"></div>
    </div>
    <table>
      <thead><tr><th>Type</th><th style="text-align:right">ARR</th><th style="text-align:right">Opps</th></tr></thead>
      <tbody id="plTypeBody"></tbody>
    </table>
    <div style="margin-top:20px">
      <div style="font-size:11px;color:#475569;margin-bottom:10px;font-weight:600;letter-spacing:0.4px;text-transform:uppercase;">Share of ARR</div>
      <div id="plShareBars"></div>
    </div>
  </div>

</div>

<!-- Funnel Conversion by Channel -->
<div class="chart-card" id="funnelCard">
  <div class="chart-header" style="margin-bottom:16px;">
    <div>
      <div class="chart-title">Pipeline Funnel Conversion</div>
      <div class="chart-subtitle">Deals created in period · current stage distribution · by channel</div>
    </div>
    <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
      <div style="display:flex;gap:4px;" id="funnelPeriodToggle"></div>
      <div style="width:1px;height:20px;background:#1e293b;"></div>
      <div style="display:flex;gap:4px;" id="funnelChannelToggle"></div>
    </div>
  </div>

  <!-- Summary KPIs -->
  <div id="funnelSummary" style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:20px;"></div>

  <!-- Funnel Table -->
  <div id="funnelTable"></div>
</div>

</div><!-- /sec-pipeline -->

<!-- ══ PERFORMANCE ═══════════════════════════ -->
<div id="sec-performance" class="dash-section">
<!-- Inbound vs Resell Split -->
<div class="chart-card">
  <div class="chart-header">
    <div>
      <div class="chart-title">Inbound vs. Resell Split</div>
      <div class="chart-subtitle">Monthly closed won deals by lead source — toggle between deal count and $ ARR</div>
    </div>
    <div style="display:flex;gap:4px;" id="splitToggle">
      <button class="toggle-btn active" data-key="deals">Deal Count</button>
      <button class="toggle-btn" data-key="arr">$ ARR</button>
    </div>
  </div>
  <div class="chart-wrap" style="height:240px"><canvas id="splitChart"></canvas></div>
</div>

<!-- Deal Close Velocity Cohort Chart -->
<div class="chart-card">
  <div class="chart-header">
    <div>
      <div class="chart-title">Deal Close Velocity by Cohort</div>
      <div class="chart-subtitle">Cumulative % of deals closed won by month after origination · May '26 dotted (in progress)</div>
    </div>
    <div id="cohortToggle" style="display:flex;gap:4px;flex-wrap:wrap;"></div>
  </div>
  <div class="chart-wrap" style="height:280px"><canvas id="cohortChart"></canvas></div>
</div>

<!-- Partner Revenue % of Rillet Revenue -->
<div class="chart-card">
  <div class="chart-header">
    <div>
      <div class="chart-title">Partner Revenue as % of Rillet Revenue</div>
      <div class="chart-subtitle">Monthly closed won ARR from partner deals ÷ total Rillet closed won ARR · dashed line = YTD average (10.2%)</div>
    </div>
  </div>
  <div class="chart-wrap" style="height:260px"><canvas id="partnerPctChart"></canvas></div>
</div>

</div><!-- /sec-performance -->

<!-- ══ PARTNERS ════════════════════════════== -->
<div id="sec-partners" class="dash-section">
<!-- Partner Referral Activity -->
<div class="chart-card">
  <div class="chart-header">
    <div>
      <div class="chart-title">% of Partners Sending Referrals</div>
      <div class="chart-subtitle">Distinct partners who introduced at least one deal, as % of 100 total partner accounts</div>
    </div>
  </div>
  <div class="chart-wrap" style="height:220px"><canvas id="referralChart"></canvas></div>
</div>

<!-- Partner Leaderboard -->
<div class="chart-card">
  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:24px;flex-wrap:wrap;gap:12px;">
    <div>
      <div class="chart-title">Partner Leaderboard</div>
      <div class="chart-subtitle">Closed Won · lines connect the same partner across both rankings</div>
    </div>
    <div id="lbToggle" style="display:flex;gap:4px;flex-wrap:wrap;justify-content:flex-end;"></div>
  </div>
  <div style="position:relative;display:grid;grid-template-columns:1fr 110px 1fr;align-items:start;">
    <!-- Deal Count -->
    <div>
      <div style="display:grid;grid-template-columns:28px 1fr auto;gap:0 10px;padding:0 12px 10px;border-bottom:1px solid #1e293b;margin-bottom:2px;">
        <span style="font-size:10px;font-weight:600;color:#475569;text-transform:uppercase;letter-spacing:.5px">#</span>
        <span style="font-size:10px;font-weight:600;color:#475569;text-transform:uppercase;letter-spacing:.5px">Partner</span>
        <span style="font-size:10px;font-weight:600;color:#475569;text-transform:uppercase;letter-spacing:.5px;text-align:right">Deals</span>
      </div>
      <div id="lbDeals"></div>
    </div>
    <!-- SVG connector -->
    <div style="position:relative;">
      <svg id="lbSvg" style="display:block;width:110px;" preserveAspectRatio="none"></svg>
    </div>
    <!-- ARR -->
    <div>
      <div style="display:grid;grid-template-columns:auto 1fr 28px;gap:0 10px;padding:0 12px 10px;border-bottom:1px solid #1e293b;margin-bottom:2px;">
        <span style="font-size:10px;font-weight:600;color:#475569;text-transform:uppercase;letter-spacing:.5px;text-align:right">ARR</span>
        <span style="font-size:10px;font-weight:600;color:#475569;text-transform:uppercase;letter-spacing:.5px">Partner</span>
        <span style="font-size:10px;font-weight:600;color:#475569;text-transform:uppercase;letter-spacing:.5px;text-align:right">#</span>
      </div>
      <div id="lbArr"></div>
    </div>
  </div>
</div>

</div><!-- /sec-partners -->

<!-- ══ DEAL DETAIL ═══════════════════════════ -->
<div id="sec-deals" class="dash-section">
<div style="margin:0 0 16px">
  <div style="font-size:13px;font-weight:700;color:#64748b;letter-spacing:1px;text-transform:uppercase;">All Partner Deals</div>
  <div style="height:1px;background:#1e293b;margin-top:8px"></div>
</div>

<div class="chart-card">
  <!-- Header -->
  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;flex-wrap:wrap;gap:10px;">
    <div>
      <div class="chart-title">Pipeline by Stage</div>
      <div class="chart-subtitle">Click any stage row to drill into individual deals</div>
    </div>
    <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap;">
      <span style="font-size:10px;font-weight:600;color:#475569;text-transform:uppercase;letter-spacing:.4px;margin-right:2px;">Period:</span>
      <div id="dealPeriodToggle" style="display:flex;gap:4px;flex-wrap:wrap;"></div>
    </div>
  </div>
  <!-- Summary strip -->
  <div id="dealSummaryStrip" style="display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:20px;"></div>
  <!-- Stage accordion -->
  <div id="stageAccordion"></div>
  <!-- Closed Lost accordion -->
  <div id="lostAccordion" style="margin-top:8px;"></div>
</div>

</div><!-- /sec-deals -->

<div class="footer">Rillet · Partner Dashboard · Data from Salesforce via CD Connect</div>

<script>
// ─────────────────────────────────────────────
// SHARED HELPERS
// ─────────────────────────────────────────────
const CHART_DEFAULTS = {
  bg: '#1e293b', border: '#334155',
  title: '#f1f5f9', body: '#94a3b8', pad: 12,
};
function tooltipDefaults() {
  return {
    backgroundColor: CHART_DEFAULTS.bg,
    borderColor: CHART_DEFAULTS.border,
    borderWidth: 1,
    titleColor: CHART_DEFAULTS.title,
    bodyColor: CHART_DEFAULTS.body,
    padding: CHART_DEFAULTS.pad,
  };
}
function scaleDefaults() {
  return {
    x: { grid:{ color:'rgba(255,255,255,0.04)' }, ticks:{ color:'#475569', font:{size:11} }, border:{ color:'#1e293b' } },
    y: { grid:{ color:'rgba(255,255,255,0.04)' }, ticks:{ color:'#475569', font:{size:11} }, border:{ color:'#1e293b' } },
  };
}

// ─────────────────────────────────────────────
// MAIN CLOSED WON LINE CHART
// ─────────────────────────────────────────────
const raw = [
  { month:'2026-01', cARR:130900, deals:9 },
  { month:'2026-02', cARR:105950, deals:5 },
  { month:'2026-03', cARR:55800,  deals:5 },
  { month:'2026-04', cARR:146250, deals:5 },
  { month:'2026-05', cARR:153950, deals:5 },
];

const MONTH_LABELS = ["Jan '26","Feb '26","Mar '26","Apr '26","May '26"];
const PROJECTED_MAY = Math.round(153950 * (31/21));

(function() {
  const ctx = document.getElementById('mainChart').getContext('2d');
  const g = ctx.createLinearGradient(0,0,0,320);
  g.addColorStop(0,'rgba(99,102,241,0.3)'); g.addColorStop(1,'rgba(99,102,241,0)');

  new Chart(ctx, {
    type: 'line',
    data: {
      labels: [...MONTH_LABELS, "May '26 (proj)"],
      datasets: [
        {
          label: 'ARR',
          data: [...raw.map(d => d.cARR), null],
          borderColor: '#6366f1', backgroundColor: g,
          borderWidth: 2.5, fill: true, tension: 0.4, spanGaps: false,
          pointBackgroundColor: '#6366f1', pointBorderColor: '#0a0d14',
          pointBorderWidth: 2, pointRadius: 5, pointHoverRadius: 7,
        },
        {
          label: 'Projected',
          data: [null, null, null, null, raw[4].cARR, PROJECTED_MAY],
          borderColor: '#6366f1', backgroundColor: 'transparent',
          borderWidth: 2, borderDash: [5,4], fill: false, tension: 0.4, spanGaps: true,
          pointRadius: [0,0,0,0,0,5],
          pointHoverRadius: [0,0,0,0,0,7],
          pointBackgroundColor: 'rgba(99,102,241,0.4)',
          pointBorderColor: '#6366f1', pointBorderWidth: 2,
        },
      ]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      interaction: { mode:'index', intersect:false },
      plugins: {
        legend: { display:false },
        tooltip: {
          ...tooltipDefaults(),
          callbacks: {
            label: ctx => {
              if (ctx.parsed.y == null) return null;
              const isProj = ctx.dataset.label === 'Projected';
              return ` ${isProj ? 'Projected (full month)' : 'ARR'}: $${ctx.parsed.y.toLocaleString()}`;
            }
          }
        }
      },
      scales: {
        ...scaleDefaults(),
        y: { ...scaleDefaults().y, ticks: { ...scaleDefaults().y.ticks, callback: v => '$'+(v>=1000?v/1000+'K':v) } }
      }
    }
  });
})();

// ─────────────────────────────────────────────
// PARTNER TYPE TABLE + TOGGLE
// ─────────────────────────────────────────────
const typeData = {
  'YTD':      { acc:{arr:325400,deals:19}, pe:{arr:192050,deals:7}, tech:{arr:75400,deals:3},  unattr:{arr:0,deals:0} },
  "May '26":  { acc:{arr:113950,deals:4},  pe:{arr:40000, deals:1}, tech:{arr:0,    deals:0},  unattr:{arr:0,deals:0} },
  "Apr '26":  { acc:{arr:51750, deals:2},  pe:{arr:54000, deals:2}, tech:{arr:40500,deals:1},  unattr:{arr:0,deals:0} },
  "Mar '26":  { acc:{arr:16800, deals:3},  pe:{arr:39000, deals:2}, tech:{arr:0,    deals:0},  unattr:{arr:0,deals:0} },
  "Feb '26":  { acc:{arr:46900, deals:3},  pe:{arr:59050, deals:2}, tech:{arr:0,    deals:0},  unattr:{arr:0,deals:0} },
  "Jan '26":  { acc:{arr:96000, deals:7},  pe:{arr:0,     deals:0}, tech:{arr:34900,deals:2},  unattr:{arr:0,deals:0} },
};
const TYPES = [
  { key:'acc',  label:'Accounting & Advisory', color:'#6366f1' },
  { key:'pe',   label:'Private Equity / VC',   color:'#f59e0b' },
  { key:'tech', label:'Technology Partner',    color:'#10b981' },
];

let activeToggle = 'YTD';

function renderTypeTable(key) {
  const d = typeData[key];
  const total = TYPES.reduce((s,t) => s + d[t.key].arr, 0);
  document.getElementById('typeTableBody').innerHTML = TYPES.map(t => `
    <tr>
      <td><span style="display:inline-flex;align-items:center;gap:7px;">
        <span style="width:8px;height:8px;border-radius:50%;background:${t.color};flex-shrink:0"></span>${t.label}
      </span></td>
      <td class="num">${d[t.key].arr ? '$'+d[t.key].arr.toLocaleString() : '—'}</td>
      <td class="num">${d[t.key].deals || '—'}</td>
    </tr>`).join('') + (d.unattr.arr ? `
    <tr style="border-top:1px solid #1e293b">
      <td style="color:#475569;font-size:12px;">Unattributed</td>
      <td class="num" style="color:#475569;font-size:12px;">$${d.unattr.arr.toLocaleString()}</td>
      <td class="num" style="color:#475569;font-size:12px;">${d.unattr.deals}</td>
    </tr>` : '');

  document.getElementById('shareBars').innerHTML = TYPES.map(t => {
    const pct = total > 0 ? Math.round(d[t.key].arr / total * 100) : 0;
    return `<div style="margin-bottom:10px">
      <div style="display:flex;justify-content:space-between;font-size:11px;color:#94a3b8;margin-bottom:4px;">
        <span>${t.label}</span><span>${pct}%</span>
      </div>
      <div style="height:5px;background:#1e293b;border-radius:3px;overflow:hidden">
        <div style="width:${pct}%;height:100%;background:${t.color};border-radius:3px;transition:width 0.4s ease"></div>
      </div>
    </div>`;
  }).join('');
}

(function() {
  const el = document.getElementById('typeToggle');
  Object.keys(typeData).forEach(key => {
    const btn = document.createElement('button');
    btn.className = 'toggle-btn' + (key === activeToggle ? ' active' : '');
    btn.textContent = key;
    btn.addEventListener('click', () => {
      activeToggle = key;
      el.querySelectorAll('.toggle-btn').forEach(b => b.classList.toggle('active', b.textContent === key));
      renderTypeTable(key);
    });
    el.appendChild(btn);
  });
  renderTypeTable(activeToggle);
})();

