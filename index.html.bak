  // ── Config ──────────────────────────────────
  // Ordered most-mature → least (Closed Lost handled separately)
  const ACTIVE_STAGES = [
    "Closed Won",
    "6 - Verbal Commit",
    "5 - Negotiation",
    "4 - Solution Validation",
    "3 - Technical Alignment",
    "2 - Discovery",
    "1 - Qualification",
  ];

  const STAGE_COLORS = {
    "Closed Won":              { bg:"rgba(16,185,129,0.12)",  bar:"#10b981", text:"#6ee7b7",  pill_bg:"rgba(16,185,129,0.15)",  pill_bd:"rgba(16,185,129,0.4)"  },
    "6 - Verbal Commit":       { bg:"rgba(139,92,246,0.10)", bar:"#8b5cf6", text:"#c4b5fd",  pill_bg:"rgba(139,92,246,0.15)",  pill_bd:"rgba(139,92,246,0.4)"  },
    "5 - Negotiation":         { bg:"rgba(236,72,153,0.10)", bar:"#ec4899", text:"#f9a8d4",  pill_bg:"rgba(236,72,153,0.15)",  pill_bd:"rgba(236,72,153,0.4)"  },
    "4 - Solution Validation": { bg:"rgba(249,115,22,0.10)", bar:"#f97316", text:"#fdba74",  pill_bg:"rgba(249,115,22,0.15)",  pill_bd:"rgba(249,115,22,0.4)"  },
    "3 - Technical Alignment": { bg:"rgba(245,158,11,0.10)", bar:"#f59e0b", text:"#fcd34d",  pill_bg:"rgba(245,158,11,0.15)",  pill_bd:"rgba(245,158,11,0.4)"  },
    "2 - Discovery":           { bg:"rgba(6,182,212,0.10)",  bar:"#06b6d4", text:"#67e8f9",  pill_bg:"rgba(6,182,212,0.15)",   pill_bd:"rgba(6,182,212,0.4)"   },
    "1 - Qualification":       { bg:"rgba(99,102,241,0.10)", bar:"#6366f1", text:"#a5b4fc",  pill_bg:"rgba(99,102,241,0.15)",  pill_bd:"rgba(99,102,241,0.4)"  },
    "Closed Lost":             { bg:"rgba(100,116,139,0.08)",bar:"#475569", text:"#64748b",  pill_bg:"rgba(100,116,139,0.12)", pill_bd:"rgba(100,116,139,0.3)" },
  };

  const MONTH_LABELS = { "2026-01":"Jan '26","2026-02":"Feb '26","2026-03":"Mar '26","2026-04":"Apr '26","2026-05":"May '26" };

  const PERIODS = [
    { key:"ytd",     label:"YTD" },
    { key:"2026-05", label:"May" },
    { key:"2026-04", label:"Apr" },
    { key:"2026-03", label:"Mar" },
    { key:"2026-02", label:"Feb" },
    { key:"2026-01", label:"Jan" },
  ];

  let activePeriod = "ytd";
  // Which stage groups are expanded — Closed Won open by default
  const expandedStages = new Set();
  let lostExpanded = false;

  // ── Helpers ─────────────────────────────────
  function fmt(n) {
    if (!n && n !== 0) return '—';
    return '$' + (n >= 1000 ? (n/1000).toFixed(1).replace(/\.0$/,'') + 'K' : n.toLocaleString());
  }

  function stagePill(stage) {
    const c = STAGE_COLORS[stage] || STAGE_COLORS["1 - Qualification"];
    const label = stage.replace(/^\d+ - /, '');
    return `<span style="display:inline-block;padding:2px 9px;border-radius:20px;font-size:10px;font-weight:600;letter-spacing:.3px;background:${c.pill_bg};border:1px solid ${c.pill_bd};color:${c.text};white-space:nowrap;">${label}</span>`;
  }

  function buildDealTable(deals, isWon) {
    const wrap = document.createElement('div');
    wrap.style.cssText = 'overflow-x:auto;padding:2px 0 10px;';
    const tbl = document.createElement('table');
    tbl.style.cssText = 'width:100%;';
    tbl.innerHTML = `<thead><tr>
      <th style="padding-left:20px;">Deal</th>
      <th>Partner</th><th>Type</th>
      <th style="text-align:right">ARR</th>
      <th>Originated</th>
    </tr></thead>`;
    const tbody = document.createElement('tbody');
    deals.slice().sort((a,b) => a[5].localeCompare(b[5])).forEach(([name,,partner,arr,,month]) => {
      const ptype = ALL_PARTNER_TYPES[partner] || '—';
      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td style="padding-left:20px;color:${isWon?'#e2e8f0':'#94a3b8'};max-width:280px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${name}</td>
        <td style="color:#64748b;">${partner}</td>
        <td style="color:#475569;font-size:12px;">${ptype}</td>
        <td class="num" style="color:${isWon?'#6ee7b7':'#f1f5f9'};font-weight:600;">${fmt(arr)}</td>
        <td style="color:#475569;font-size:12px;white-space:nowrap;">${MONTH_LABELS[month]||month}</td>
      `;
      tbody.appendChild(tr);
    });
    tbl.appendChild(tbody);
    wrap.appendChild(tbl);
    return wrap;
  }

  function buildAccordionItem(stage, deals, isExpanded, onToggle) {
    const c = STAGE_COLORS[stage];
    const isWon = stage === 'Closed Won';
    const isLost = stage === 'Closed Lost';
    const stageArr = deals.reduce((s,d) => s + (d[3]||0), 0);

    const item = document.createElement('div');
    item.style.cssText = 'margin-bottom:5px;border-radius:10px;overflow:hidden;border:1px solid #1e293b;';

    // Header row
    const hdr = document.createElement('div');
    hdr.style.cssText = `display:flex;align-items:center;gap:10px;padding:11px 14px;cursor:pointer;background:${c.bg};user-select:none;`;
    hdr.innerHTML = `
      <span class="chev" style="font-size:10px;color:#475569;transition:transform .18s;display:inline-block;transform:rotate(${isExpanded?'90':'0'}deg);">▶</span>
      ${stagePill(stage)}
      <span style="font-size:12px;color:#475569;flex-shrink:0;">${deals.length} deal${deals.length!==1?'s':''}</span>
      <div style="flex:1;height:3px;background:rgba(255,255,255,0.05);border-radius:2px;overflow:hidden;min-width:40px;">
        <div class="stgbar" style="height:100%;background:${c.bar};border-radius:2px;opacity:0.7;"></div>
      </div>
      <span style="font-size:16px;font-weight:800;letter-spacing:-.6px;color:${isWon?'#34d399':isLost?'#475569':'#f1f5f9'};flex-shrink:0;min-width:72px;text-align:right;">${fmt(stageArr)}</span>
    `;

    // Body
    const body = document.createElement('div');
    body.style.cssText = `display:${isExpanded?'block':'none'};background:#0d1117;border-top:1px solid #1e293b;`;
    body.appendChild(buildDealTable(deals, isWon));

    hdr.addEventListener('click', () => {
      const open = body.style.display !== 'none';
      body.style.display = open ? 'none' : 'block';
      hdr.querySelector('.chev').style.transform = open ? 'rotate(0deg)' : 'rotate(90deg)';
      onToggle(!open);
    });

    item.appendChild(hdr);
    item.appendChild(body);
    return { el: item, barEl: item.querySelector('.stgbar') };
  }

  // ── Render ───────────────────────────────────
  function render() {
    const all = activePeriod === 'ytd' ? RAW.slice() : RAW.filter(d => d[5] === activePeriod);
    const active = all.filter(d => d[1] !== 'Closed Lost');
    const lost   = all.filter(d => d[1] === 'Closed Lost');

    // Group by stage
    const byStage = {};
    ACTIVE_STAGES.forEach(s => byStage[s] = []);
    active.forEach(d => { if (byStage[d[1]]) byStage[d[1]].push(d); });

    const wonArr      = (byStage['Closed Won'] || []).reduce((s,d) => s + d[3], 0);
    const pipelineArr = ACTIVE_STAGES.filter(s => s !== 'Closed Won')
                          .reduce((s, st) => s + (byStage[st]||[]).reduce((x,d) => x + d[3], 0), 0);
    const openDeals   = active.filter(d => d[1] !== 'Closed Won').length;

    // Max stage ARR for proportional bars (across all stages)
    const stageTotals = ACTIVE_STAGES.map(s => (byStage[s]||[]).reduce((x,d) => x+d[3],0));
    const maxArr = Math.max(...stageTotals, 1);

    // Summary strip
    const strip = document.getElementById('dealSummaryStrip');
    strip.innerHTML = `
      <div style="background:rgba(16,185,129,0.07);border:1px solid rgba(16,185,129,0.2);border-radius:10px;padding:12px 16px;">
        <div style="font-size:10px;font-weight:700;letter-spacing:.6px;text-transform:uppercase;color:#10b981;margin-bottom:5px;">Revenue Won</div>
        <div style="font-size:22px;font-weight:800;letter-spacing:-.7px;color:#34d399;">${fmt(wonArr)}</div>
        <div style="font-size:11px;color:#475569;margin-top:3px;">${byStage['Closed Won'].length} deals closed</div>
      </div>
      <div style="background:rgba(99,102,241,0.07);border:1px solid rgba(99,102,241,0.2);border-radius:10px;padding:12px 16px;">
        <div style="font-size:10px;font-weight:700;letter-spacing:.6px;text-transform:uppercase;color:#6366f1;margin-bottom:5px;">Open Pipeline</div>
        <div style="font-size:22px;font-weight:800;letter-spacing:-.7px;color:#a5b4fc;">${fmt(pipelineArr)}</div>
        <div style="font-size:11px;color:#475569;margin-top:3px;">${openDeals} open deals</div>
      </div>
      <div style="background:rgba(245,158,11,0.07);border:1px solid rgba(245,158,11,0.2);border-radius:10px;padding:12px 16px;">
        <div style="font-size:10px;font-weight:700;letter-spacing:.6px;text-transform:uppercase;color:#f59e0b;margin-bottom:5px;">Potential Upside</div>
        <div style="font-size:22px;font-weight:800;letter-spacing:-.7px;color:#fcd34d;">${fmt(wonArr + pipelineArr)}</div>
        <div style="font-size:11px;color:#475569;margin-top:3px;">won + full pipeline</div>
      </div>
    `;

    // Stage accordion
    const accordion = document.getElementById('stageAccordion');
    accordion.innerHTML = '';
    ACTIVE_STAGES.forEach((stage, i) => {
      const deals = byStage[stage];
      if (!deals.length) return;
      const { el, barEl } = buildAccordionItem(
        stage, deals, expandedStages.has(stage),
        open => open ? expandedStages.add(stage) : expandedStages.delete(stage)
      );
      const pct = stageTotals[i] / maxArr * 100;
      barEl.style.width = pct + '%';
      accordion.appendChild(el);
    });

    // Closed Lost accordion (separate, dimmed)
    const lostEl = document.getElementById('lostAccordion');
    lostEl.innerHTML = '';
    if (lost.length) {
      const lostArr = lost.reduce((s,d) => s + d[3], 0);
      const { el } = buildAccordionItem('Closed Lost', lost, lostExpanded, open => { lostExpanded = open; });
      // Override bar width based on lost vs max active stage
      const barPct = lostArr / maxArr * 100;
      el.querySelector('.stgbar').style.width = Math.min(barPct, 100) + '%';
      lostEl.appendChild(el);
    }
  }

  // Period toggle
  const toggleEl = document.getElementById('dealPeriodToggle');
  PERIODS.forEach(p => {
    const btn = document.createElement('button');
    btn.className = 'toggle-btn' + (p.key === activePeriod ? ' active' : '');
    btn.textContent = p.label;
    btn.addEventListener('click', () => {
      activePeriod = p.key;
      toggleEl.querySelectorAll('.toggle-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      render();
    });
    toggleEl.appendChild(btn);
  });

  render();
})();

// ─────────────────────────────────────────────
// TAB NAVIGATION
// ─────────────────────────────────────────────
(function() {
  const tabs  = document.querySelectorAll('#dashTabs .tab-btn');
  const secs  = ['sec-overview','sec-pipeline','sec-performance','sec-partners','sec-deals'];
  const NAV_H = 50;

  // Click: smooth scroll + immediate active state
  tabs.forEach(btn => {
    btn.addEventListener('click', () => {
      const el = document.getElementById(btn.dataset.target);
      if (!el) return;
      const y = el.getBoundingClientRect().top + window.scrollY - NAV_H - 4;
      window.scrollTo({ top: y, behavior: 'smooth' });
      tabs.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
    });
  });

  // Scroll: auto-highlight whichever section is at the top of the viewport
  const observer = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        tabs.forEach(b => b.classList.toggle('active', b.dataset.target === entry.target.id));
      }
    });
  }, { rootMargin: `-${NAV_H}px 0px -55% 0px`, threshold: 0 });

  secs.forEach(id => { const el = document.getElementById(id); if (el) observer.observe(el); });
})();
</script>
</body>
</html>
