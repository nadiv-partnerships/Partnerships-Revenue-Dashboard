const LB_PERIODS = [
  { key:'ytd',     label:'YTD',      filter: r => r.month >= '2026-01' },
  { key:'2026-05', label:"May '26",  filter: r => r.month === '2026-05' },
  { key:'2026-04', label:"Apr '26",  filter: r => r.month === '2026-04' },
  { key:'2026-03', label:"Mar '26",  filter: r => r.month === '2026-03' },
  { key:'2026-02', label:"Feb '26",  filter: r => r.month === '2026-02' },
  { key:'2026-01', label:"Jan '26",  filter: r => r.month === '2026-01' },
];
const ROW_H = 44, HEAD_H = 38;
let activeLb = 'ytd';

function renderLeaderboard(key) {
  const period = LB_PERIODS.find(p => p.key === key);
  const agg = {};
  lbRows.filter(period.filter).forEach(r => {
    if (!agg[r.partner]) agg[r.partner] = { arr:0, deals:0 };
    agg[r.partner].arr   += r.arr;
    agg[r.partner].deals += r.deals;
  });
  const entries = Object.entries(agg);
  const TOP = Math.min(15, entries.length);
  const byDeals = [...entries].sort((a,b) => b[1].deals - a[1].deals || b[1].arr - a[1].arr).slice(0,TOP);
  const byArr   = [...entries].sort((a,b) => b[1].arr   - a[1].arr   || b[1].deals - a[1].deals).slice(0,TOP);

  const dealRankOf = Object.fromEntries(byDeals.map(([n],i) => [n,i]));
  const arrRankOf  = Object.fromEntries(byArr.map(([n],i)   => [n,i]));

  document.getElementById('lbDeals').innerHTML = byDeals.map(([name,d],i) => `
    <div style="display:grid;grid-template-columns:28px 1fr auto;gap:0 10px;
      align-items:center;padding:0 12px;height:${ROW_H}px;border-bottom:1px solid #0f172a;">
      <span style="font-size:12px;font-weight:800;color:#334155">${i+1}</span>
      <div style="min-width:0;display:flex;align-items:center;gap:6px;overflow:hidden">
        <span style="width:7px;height:7px;border-radius:50%;background:${typeColor(name)};flex-shrink:0"></span>
        <span style="font-size:12px;font-weight:600;color:#e2e8f0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${name}</span>
      </div>
      <span style="font-size:13px;font-weight:700;color:#f1f5f9">${d.deals}</span>
    </div>`).join('');

  document.getElementById('lbArr').innerHTML = byArr.map(([name,d],i) => `
    <div style="display:grid;grid-template-columns:auto 1fr 28px;gap:0 10px;
      align-items:center;padding:0 12px;height:${ROW_H}px;border-bottom:1px solid #0f172a;">
      <span style="font-size:12px;font-weight:700;color:#f1f5f9;white-space:nowrap">$${(d.arr/1000).toFixed(0)}K</span>
      <div style="min-width:0;display:flex;align-items:center;justify-content:flex-end;gap:6px;overflow:hidden">
        <span style="font-size:12px;font-weight:600;color:#e2e8f0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${name}</span>
        <span style="width:7px;height:7px;border-radius:50%;background:${typeColor(name)};flex-shrink:0"></span>
      </div>
      <span style="font-size:12px;font-weight:800;color:#334155">${i+1}</span>
    </div>`).join('');

  // SVG bezier connectors
  const svgH = HEAD_H + TOP * ROW_H;
  const svgW = 110;
  const svg  = document.getElementById('lbSvg');
  svg.setAttribute('height', svgH);
  svg.setAttribute('viewBox', `0 0 ${svgW} ${svgH}`);

  const allNames = [...new Set([...byDeals.map(([n])=>n),...byArr.map(([n])=>n)])];
  const lines = [];
  allNames.forEach(name => {
    const di = dealRankOf[name], ai = arrRankOf[name];
    if (di === undefined || ai === undefined) return;
    const y1 = HEAD_H + di * ROW_H + ROW_H/2;
    const y2 = HEAD_H + ai * ROW_H + ROW_H/2;
    const cx = svgW/2;
    lines.push({ path:`M0,${y1} C${cx},${y1} ${cx},${y2} ${svgW},${y2}`, color:typeColor(name), y1, y2, same:di===ai });
  });
  svg.innerHTML =
    lines.map(l => `<path d="${l.path}" fill="none" stroke="${l.color}" stroke-width="${l.same?1.5:1.2}" stroke-opacity="${l.same?0.55:0.35}"/>`).join('') +
    lines.map(l => `<circle cx="0" cy="${l.y1}" r="2.5" fill="${l.color}" opacity="0.6"/><circle cx="${svgW}" cy="${l.y2}" r="2.5" fill="${l.color}" opacity="0.6"/>`).join('');
}

(function() {
  const el = document.getElementById('lbToggle');
  LB_PERIODS.forEach(p => {
    const btn = document.createElement('button');
    btn.className = 'toggle-btn' + (p.key === activeLb ? ' active' : '');
    btn.textContent = p.label;
    btn.addEventListener('click', () => {
      activeLb = p.key;
      el.querySelectorAll('.toggle-btn').forEach(b => b.classList.toggle('active', b.textContent === p.label && b === btn));
      // re-style all
      el.querySelectorAll('.toggle-btn').forEach(b => {
        const match = LB_PERIODS.find(x => x.label === b.textContent);
        b.classList.toggle('active', match?.key === activeLb);
      });
      renderLeaderboard(p.key);
    });
    el.appendChild(btn);
  });
  renderLeaderboard(activeLb);
})();

