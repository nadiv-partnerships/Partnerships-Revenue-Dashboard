const PL_PERIODS = [
  { key:'ytd',     label:'YTD',      filter: r => r.month >= '2026-01' },
  { key:'2026-05', label:"May '26",  filter: r => r.month === '2026-05' },
  { key:'2026-04', label:"Apr '26",  filter: r => r.month === '2026-04' },
  { key:'2026-03', label:"Mar '26",  filter: r => r.month === '2026-03' },
  { key:'2026-02', label:"Feb '26",  filter: r => r.month === '2026-02' },
  { key:'2026-01', label:"Jan '26",  filter: r => r.month === '2026-01' },
];
const PL_TYPES = [
  { label:'Accounting & Advisory', color:'#6366f1' },
  { label:'Private Equity / VC',   color:'#f59e0b' },
  { label:'Technology Partner',    color:'#10b981' },
];
let activePlType = 'ytd';

function getPlTypeData(filterFn) {
  const filtered = plRows.filter(filterFn);
  const totals = { 'Accounting & Advisory':{arr:0,opps:0}, 'Private Equity / VC':{arr:0,opps:0}, 'Technology Partner':{arr:0,opps:0} };
  let attrTotal = 0;
  filtered.forEach(r => {
    const t = ALL_PARTNER_TYPES[r.partner];
    if (t && totals[t]) { totals[t].arr += r.arr; totals[t].opps += r.opps; attrTotal += r.arr; }
  });
  const months = [...new Set(filtered.map(r => r.month))];
  const monthTotal = months.reduce((s,m) => s + (plMonthlyTotals[m] || 0), 0);
  return { totals, unattr: Math.max(0, monthTotal - attrTotal) };
}

function renderPlTypeTable(key) {
  const period = PL_PERIODS.find(p => p.key === key);
  const { totals, unattr } = getPlTypeData(period.filter);
  const attributed = Object.values(totals).reduce((s,v) => s + v.arr, 0);

  document.getElementById('plTypeBody').innerHTML = PL_TYPES.map(t => `
    <tr>
      <td><span style="display:inline-flex;align-items:center;gap:7px;">
        <span style="width:8px;height:8px;border-radius:50%;background:${t.color};flex-shrink:0"></span>${t.label}
      </span></td>
      <td class="num">${totals[t.label].arr ? '$'+totals[t.label].arr.toLocaleString() : '—'}</td>
      <td class="num">${totals[t.label].opps || '—'}</td>
    </tr>`).join('') + (unattr > 0 ? `
    <tr style="border-top:1px solid #1e293b">
      <td style="color:#475569;font-size:12px;">Unattributed</td>
      <td class="num" style="color:#475569;font-size:12px;">$${Math.round(unattr).toLocaleString()}</td>
      <td class="num" style="color:#475569;font-size:12px;">—</td>
    </tr>` : '');

  document.getElementById('plShareBars').innerHTML = PL_TYPES.map(t => {
    const pct = attributed > 0 ? Math.round(totals[t.label].arr / attributed * 100) : 0;
    return `<div style="margin-bottom:10px">
      <div style="display:flex;justify-content:space-between;font-size:11px;color:#94a3b8;margin-bottom:4px;">
        <span>${t.label}</span><span>${pct}%</span>
      </div>
      <div style="height:5px;background:#1e293b;border-radius:3px;overflow:hidden">
        <div style="width:${pct}%;height:100%;background:${t.color};border-radius:3px;transition:width 0.4s ease"></div>
      </div>
    </div>`;
  }).join('');
}

// Pipeline line chart
(function() {
  const PL_PROJECTED = Math.round(984924 * (31/21));
  const ctx = document.getElementById('pipelineChart').getContext('2d');
  const g = ctx.createLinearGradient(0,0,0,320);
  g.addColorStop(0,'rgba(16,185,129,0.3)'); g.addColorStop(1,'rgba(16,185,129,0)');

  new Chart(ctx, {
    type: 'line',
    data: {
      labels: [...MONTH_LABELS, "May '26 (proj)"],
      datasets: [
        {
          label: 'Pipeline ARR',
          data: [162948, 1209170, 1051328, 1583554, 984924, null],
          borderColor: '#10b981', backgroundColor: g,
          borderWidth: 2.5, fill: true, tension: 0.4, spanGaps: false,
          pointBackgroundColor: '#10b981', pointBorderColor: '#0a0d14',
          pointBorderWidth: 2, pointRadius: 5, pointHoverRadius: 7,
        },
        {
          label: 'Projected',
          data: [null, null, null, null, 984924, PL_PROJECTED],
          borderColor: '#10b981', backgroundColor: 'transparent',
          borderWidth: 2, borderDash: [5,4], fill: false, tension: 0.4, spanGaps: true,
          pointRadius: [0,0,0,0,0,5], pointHoverRadius: [0,0,0,0,0,7],
          pointBackgroundColor: 'rgba(16,185,129,0.4)',
          pointBorderColor: '#10b981', pointBorderWidth: 2,
        }
      ]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      interaction: { mode:'index', intersect:false },
      plugins: {
        legend: { display:false },
        tooltip: {
          ...tooltipDefaults(),
          callbacks: {
            label: ctx => {
              if (ctx.parsed.y == null) return null;
              const isProj = ctx.dataset.label === 'Projected';
              return ` ${isProj ? 'Projected' : 'Pipeline ARR'}: $${ctx.parsed.y.toLocaleString()}`;
            }
          }
        }
      },
      scales: {
        ...scaleDefaults(),
        y: { ...scaleDefaults().y, ticks: { ...scaleDefaults().y.ticks,
          callback: v => '$'+(v>=1000000?(v/1000000).toFixed(1)+'M':v>=1000?(v/1000).toFixed(0)+'K':v)
        }}
      }
    }
  });
})();

// Pipeline type toggle
(function() {
  const el = document.getElementById('plTypeToggle');
  PL_PERIODS.forEach(p => {
    const btn = document.createElement('button');
    btn.className = 'toggle-btn' + (p.key === activePlType ? ' active' : '');
    btn.textContent = p.label;
    btn.addEventListener('click', () => {
      activePlType = p.key;
      el.querySelectorAll('.toggle-btn').forEach(b => {
        const match = PL_PERIODS.find(x => x.label === b.textContent);
        b.classList.toggle('active', match?.key === activePlType);
      });
      renderPlTypeTable(p.key);
    });
    el.appendChild(btn);
  });
  renderPlTypeTable(activePlType);
})();

// ─────────────────────────────────────────────
// PIPELINE FUNNEL CONVERSION TABLE
// ─────────────────────────────────────────────
(function() {
  // Data: deals created in each period, by channel, showing current stage
  // Source: Salesforce Opportunity created_month × LeadSource × StageName
  const STAGES = [
    { key:'qual',   label:'1 · Qualification',        color:'#475569' },
    { key:'disc',   label:'2 · Discovery',             color:'#6366f1' },
    { key:'align',  label:'3 · Technical Alignment',   color:'#8b5cf6' },
    { key:'solval', label:'4 · Solution Validation',   color:'#06b6d4' },
    { key:'neg',    label:'5 · Negotiation',           color:'#10b981' },
    { key:'verbal', label:'6 · Verbal Commit',         color:'#34d399' },
    { key:'won',    label:'Closed Won',                color:'#22c55e' },
    { key:'lost',   label:'Closed Lost',               color:'#ef4444' },
  ];

  // Raw data: { qual, disc, align, solval, neg, verbal, won, lost }
  const D = {
    'ytd_all':  { qual:66, disc:21, align:15, solval:8, neg:4, verbal:1, won:26, lost:32 },
    'ytd_acc':  { qual:19, disc:10, align:5,  solval:5, neg:1, verbal:1, won:15, lost:10 },
    'ytd_pe':   { qual:26, disc:7,  align:6,  solval:2, neg:2, verbal:0, won:8,  lost:8  },
    'ytd_tech': { qual:18, disc:4,  align:3,  solval:0, neg:1, verbal:0, won:3,  lost:7  },
    'jan_all':  { qual:0,  disc:0,  align:0,  solval:0, neg:0, verbal:0, won:3,  lost:3  },
    'jan_acc':  { qual:0,  disc:0,  align:0,  solval:0, neg:0, verbal:0, won:1,  lost:3  },
    'jan_pe':   { qual:0,  disc:0,  align:0,  solval:0, neg:0, verbal:0, won:1,  lost:0  },
    'jan_tech': { qual:0,  disc:0,  align:0,  solval:0, neg:0, verbal:0, won:1,  lost:0  },
    'feb_all':  { qual:10, disc:2,  align:2,  solval:3, neg:0, verbal:0, won:7,  lost:19 },
    'feb_acc':  { qual:2,  disc:0,  align:0,  solval:3, neg:0, verbal:0, won:2,  lost:5  },
    'feb_pe':   { qual:4,  disc:1,  align:1,  solval:0, neg:0, verbal:0, won:5,  lost:4  },
    'feb_tech': { qual:4,  disc:1,  align:1,  solval:0, neg:0, verbal:0, won:0,  lost:3  },
    'mar_all':  { qual:9,  disc:3,  align:4,  solval:4, neg:2, verbal:1, won:10, lost:6  },
    'mar_acc':  { qual:1,  disc:2,  align:3,  solval:2, neg:0, verbal:1, won:7,  lost:1  },
    'mar_pe':   { qual:3,  disc:1,  align:0,  solval:2, neg:2, verbal:0, won:1,  lost:2  },
    'mar_tech': { qual:5,  disc:0,  align:1,  solval:0, neg:0, verbal:0, won:2,  lost:3  },
    'apr_all':  { qual:25, disc:11, align:7,  solval:1, neg:1, verbal:0, won:4,  lost:4  },
    'apr_acc':  { qual:10, disc:5,  align:2,  solval:0, neg:0, verbal:0, won:3,  lost:1  },
    'apr_pe':   { qual:6,  disc:4,  align:4,  solval:0, neg:0, verbal:0, won:1,  lost:2  },
    'apr_tech': { qual:6,  disc:2,  align:1,  solval:0, neg:1, verbal:0, won:0,  lost:1  },
    'may_all':  { qual:22, disc:5,  align:2,  solval:0, neg:1, verbal:0, won:2,  lost:0  },
    'may_acc':  { qual:6,  disc:3,  align:0,  solval:0, neg:1, verbal:0, won:2,  lost:0  },
    'may_pe':   { qual:13, disc:1,  align:1,  solval:0, neg:0, verbal:0, won:0,  lost:0  },
    'may_tech': { qual:3,  disc:1,  align:0,  solval:0, neg:0, verbal:0, won:0,  lost:0  },
  };

  const PERIODS = [
    { key:'ytd', label:'YTD' },
    { key:'may', label:"May '26" },
    { key:'apr', label:"Apr '26" },
    { key:'mar', label:"Mar '26" },
    { key:'feb', label:"Feb '26" },
    { key:'jan', label:"Jan '26" },
  ];
  const CHANNELS = [
    { key:'all',  label:'All' },
    { key:'acc',  label:'Accounting' },
    { key:'pe',   label:'PE / VC' },
    { key:'tech', label:'Tech' },
  ];

  let activePeriod = 'ytd', activeChannel = 'all';

  function getData() {
    return D[`${activePeriod}_${activeChannel}`];
  }

  function render() {
    const d = getData();
    const summaryEl = document.getElementById('funnelSummary');
    const tableEl   = document.getElementById('funnelTable');

    if (!d) {
      summaryEl.innerHTML = `<div style="grid-column:1/-1;text-align:center;color:#475569;padding:24px;font-size:13px;">No data for this selection</div>`;
      tableEl.innerHTML = '';
      return;
    }

    const total   = STAGES.reduce((s, st) => s + d[st.key], 0);
    const active  = total - d.won - d.lost;
    const decided = d.won + d.lost;
    const winRate = decided > 0 ? Math.round(d.won / decided * 100) : null;
    // Advanced = moved past Qualification
    const advanced = total - d.qual - d.won - d.lost;

    // Summary KPIs
    summaryEl.innerHTML = [
      { label:'Created',    value: total,                    sub: 'deals this period' },
      { label:'Active',     value: active,                   sub: `${total > 0 ? Math.round(active/total*100) : 0}% of created still open` },
      { label:'Closed Won', value: d.won,                    sub: `${total > 0 ? Math.round(d.won/total*100) : 0}% of all created` },
      { label:'Win Rate',   value: winRate !== null ? winRate+'%' : '—', sub: `of decided deals (${decided} total)` },
    ].map((k, i) => {
      const accents = ['#6366f1,#8b5cf6','#06b6d4,#6366f1','#10b981,#06b6d4','#f59e0b,#f97316'];
      return `<div style="background:#0f172a;border:1px solid #1e293b;border-radius:10px;padding:14px 16px;position:relative;overflow:hidden;">
        <div style="position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,${accents[i]});"></div>
        <div style="font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:0.5px;color:#64748b;margin-bottom:6px;">${k.label}</div>
        <div style="font-size:22px;font-weight:800;color:#f1f5f9;letter-spacing:-0.5px;">${k.value}</div>
        <div style="font-size:11px;color:#475569;margin-top:3px;">${k.sub}</div>
      </div>`;
    }).join('');

    // Stage table
    const maxActive = Math.max(...STAGES.filter(s => s.key !== 'won' && s.key !== 'lost').map(s => d[s.key]));
    const activeStageCounts = STAGES.filter(s => s.key !== 'won' && s.key !== 'lost');

    tableEl.innerHTML = `
      <div style="display:grid;grid-template-columns:180px 1fr 60px 70px;gap:0;border:1px solid #1e293b;border-radius:10px;overflow:hidden;">
        <div style="padding:8px 12px;font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:0.5px;color:#475569;background:#0f172a;border-bottom:1px solid #1e293b;">Stage</div>
        <div style="padding:8px 12px;font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:0.5px;color:#475569;background:#0f172a;border-bottom:1px solid #1e293b;">Distribution</div>
        <div style="padding:8px 12px;font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:0.5px;color:#475569;background:#0f172a;border-bottom:1px solid #1e293b;text-align:right;">Count</div>
        <div style="padding:8px 12px;font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:0.5px;color:#475569;background:#0f172a;border-bottom:1px solid #1e293b;text-align:right;">% of Total</div>
        ${STAGES.map((st, i) => {
          const count = d[st.key];
          const pct   = total > 0 ? +(count / total * 100).toFixed(1) : 0;
          const barW  = total > 0 ? (count / total * 100) : 0;
          const isCW  = st.key === 'won';
          const isCL  = st.key === 'lost';
          const rowBg = i % 2 === 0 ? '#111827' : '#0f172a';
          const divider = (isCW) ? 'border-top:1px solid #1e293b;' : '';
          return `
            <div style="padding:10px 12px;background:${rowBg};${divider}border-bottom:1px solid #0a0d14;display:flex;align-items:center;gap:8px;">
              <span style="width:8px;height:8px;border-radius:50%;background:${st.color};flex-shrink:0;"></span>
              <span style="font-size:12px;color:${isCW ? '#22c55e' : isCL ? '#ef4444' : '#94a3b8'};font-weight:${isCW||isCL?'600':'400'};">${st.label}</span>
            </div>
            <div style="padding:10px 12px;background:${rowBg};${divider}border-bottom:1px solid #0a0d14;display:flex;align-items:center;">
              <div style="flex:1;height:6px;background:#1e293b;border-radius:3px;overflow:hidden;">
                <div style="width:${barW}%;height:100%;background:${st.color};border-radius:3px;transition:width 0.4s ease;opacity:${count===0?0.2:1};"></div>
              </div>
            </div>
            <div style="padding:10px 12px;background:${rowBg};${divider}border-bottom:1px solid #0a0d14;text-align:right;font-size:13px;font-weight:${count>0?'600':'400'};color:${count>0?(isCW?'#22c55e':isCL?'#ef4444':'#e2e8f0'):'#334155'};">${count || '—'}</div>
            <div style="padding:10px 12px;background:${rowBg};${divider}border-bottom:1px solid #0a0d14;text-align:right;font-size:12px;color:${pct>0?'#94a3b8':'#334155'};">${pct > 0 ? pct+'%' : '—'}</div>
          `;
        }).join('')}
        <div style="padding:10px 12px;background:#0a0d14;grid-column:1/-1;display:flex;justify-content:space-between;align-items:center;border-top:1px solid #1e293b;">
          <span style="font-size:11px;color:#475569;">Win rate of decided deals</span>
          <span style="font-size:13px;font-weight:700;color:${winRate !== null ? '#22c55e' : '#334155'};">${winRate !== null ? winRate+'%' : '—'}&nbsp;&nbsp;(${d.won} won / ${decided} decided)</span>
        </div>
      </div>`;
  }

  // Build period toggle
  (function() {
    const el = document.getElementById('funnelPeriodToggle');
    PERIODS.forEach(p => {
      const btn = document.createElement('button');
      btn.className = 'toggle-btn' + (p.key === activePeriod ? ' active' : '');
      btn.textContent = p.label;
      btn.addEventListener('click', () => {
        activePeriod = p.key;
        el.querySelectorAll('.toggle-btn').forEach(b => b.classList.toggle('active', b.textContent === p.label && b === btn));
        // update all buttons properly
        el.querySelectorAll('.toggle-btn').forEach(b => {
          b.classList.toggle('active', PERIODS.find(x=>x.label===b.textContent)?.key === activePeriod);
        });
        render();
      });
      el.appendChild(btn);
    });
  })();

  // Build channel toggle
  (function() {
    const el = document.getElementById('funnelChannelToggle');
    CHANNELS.forEach(c => {
      const btn = document.createElement('button');
      btn.className = 'toggle-btn' + (c.key === activeChannel ? ' active' : '');
      btn.textContent = c.label;
      btn.addEventListener('click', () => {
        activeChannel = c.key;
        el.querySelectorAll('.toggle-btn').forEach(b => {
          b.classList.toggle('active', CHANNELS.find(x=>x.label===b.textContent)?.key === activeChannel);
        });
        render();
      });
      el.appendChild(btn);
    });
  })();

  render();
})();

// ─────────────────────────────────────────────
// INBOUND VS RESELL SPLIT CHART
// ─────────────────────────────────────────────
const splitRaw = {
  deals: { inbound:[5,4,3,5,3], resell:[4,1,2,0,2] },
  arr:   { inbound:[87100,87950,40200,146250,129950], resell:[43800,18000,15600,0,24000] },
};

let splitActiveKey = 'deals';

(function() {
  function buildDatasets(key) {
    return [
      {
        label: 'Inbound - Partner',
        data: splitRaw[key].inbound,
        backgroundColor: 'rgba(99,102,241,0.75)',
        borderColor: '#6366f1', borderWidth: 1,
        borderRadius: 0, stack: 'a',
      },
      {
        label: 'Partner - Resell',
        data: splitRaw[key].resell,
        backgroundColor: 'rgba(16,185,129,0.75)',
        borderColor: '#10b981', borderWidth: 1,
        borderRadius: 4, stack: 'a',
      }
    ];
  }

  const chart = new Chart(document.getElementById('splitChart').getContext('2d'), {
    type: 'bar',
    data: { labels: MONTH_LABELS, datasets: buildDatasets('deals') },
    options: {
      responsive: true, maintainAspectRatio: false,
      interaction: { mode:'index', intersect:false },
      plugins: {
        legend: {
          display: true, position:'top', align:'end',
          labels: { color:'#94a3b8', font:{size:11}, boxWidth:12, boxHeight:12, padding:16 }
        },
        tooltip: {
          ...tooltipDefaults(),
          callbacks: {
            label: ctx => {
              const v = ctx.parsed.y;
              return splitActiveKey === 'arr'
                ? ` ${ctx.dataset.label}: $${v.toLocaleString()}`
                : ` ${ctx.dataset.label}: ${v} deal${v!==1?'s':''}`;
            },
            footer: items => {
              const total = items.reduce((s,i) => s + i.parsed.y, 0);
              return splitActiveKey === 'arr'
                ? `Total: $${total.toLocaleString()}`
                : `Total: ${total} deals`;
            }
          }
        }
      },
      scales: {
        x: { ...scaleDefaults().x, stacked: true },
        y: {
          ...scaleDefaults().y, stacked: true, min: 0,
          ticks: { ...scaleDefaults().y.ticks,
            callback: v => splitActiveKey === 'arr' ? '$'+(v>=1000?(v/1000).toFixed(0)+'K':v) : v
          }
        }
      }
    }
  });

  document.getElementById('splitToggle').addEventListener('click', e => {
    const btn = e.target.closest('.toggle-btn');
    if (!btn) return;
    const key = btn.dataset.key;
    splitActiveKey = key;
    document.querySelectorAll('#splitToggle .toggle-btn').forEach(b => b.classList.toggle('active', b === btn));
    chart.data.datasets = buildDatasets(key);
    chart.options.scales.y.ticks.callback = v =>
      key === 'arr' ? '$'+(v>=1000?(v/1000).toFixed(0)+'K':v) : v;
    chart.update();
  });
})();

// ─────────────────────────────────────────────
// DEAL CLOSE VELOCITY COHORT CHART
// ─────────────────────────────────────────────
(function() {
  // Denominator = total deals generated that month
  // Numerator   = cumulative closed won, filtered to close_month >= cohort_month
  const cohortRaw = {
    "Jan '26": { total:6,  M0:2, M1:1, M2:0 },
    "Feb '26": { total:43, M0:3, M1:2, M2:2 },
    "Mar '26": { total:46, M0:2, M1:2, M2:0 },
    "Apr '26": { total:53, M0:1, M1:2, M2:0 },
    "May '26": { total:32, M0:2, M1:0, M2:0 }, // in progress
  };
  const COHORT_COLORS = ['#6366f1','#06b6d4','#10b981','#f59e0b','#ec4899'];
  const X_LABELS = ['Same Month','+1 Month','+2 Months'];

  const datasets = Object.entries(cohortRaw).map(([label, d], i) => {
    const buckets = [d.M0, d.M1, d.M2];
    let cum = 0;
    const data = buckets.map((v, j) => {
      cum += v;
      const hasData = buckets.slice(j).some(x => x > 0);
      if (!hasData && j > 0) return null;
      return +(cum / d.total * 100).toFixed(1);
    });
    return {
      label, data,
      borderColor: COHORT_COLORS[i],
      backgroundColor: 'transparent',
      borderWidth: 2,
      hidden: label === "Jan '26",  // Jan hidden by default
      ...(label === "May '26" ? { borderDash: [5,4] } : {}),
      pointBackgroundColor: COHORT_COLORS[i],
      pointBorderColor: '#0a0d14',
      pointBorderWidth: 2,
      pointRadius: data.map(v => v !== null ? 5 : 0),
      pointHoverRadius: 7,
      tension: 0.3,
      spanGaps: false,
    };
  });

  const cohortChart = new Chart(document.getElementById('cohortChart').getContext('2d'), {
    type: 'line',
    data: { labels: X_LABELS, datasets },
    options: {
      responsive: true, maintainAspectRatio: false,
      interaction: { mode:'index', intersect:false },
      plugins: {
        legend: { display: false },
        tooltip: {
          ...tooltipDefaults(),
          callbacks: { label: ctx => ctx.parsed.y != null ? ` ${ctx.dataset.label}: ${ctx.parsed.y}%` : null }
        }
      },
      scales: {
        ...scaleDefaults(),
        y: { ...scaleDefaults().y, min:0, ticks:{ ...scaleDefaults().y.ticks, callback: v => v+'%' } }
      }
    }
  });

  // Build cohort toggle buttons (replace Chart.js legend)
  const toggleEl = document.getElementById('cohortToggle');
  datasets.forEach((ds, i) => {
    const btn = document.createElement('button');
    btn.className = 'toggle-btn' + (ds.hidden ? '' : ' active');
    btn.textContent = ds.label;
    btn.style.borderColor = ds.borderColor;
    btn.addEventListener('click', () => {
      const meta = cohortChart.getDatasetMeta(i);
      meta.hidden = !meta.hidden;
      btn.classList.toggle('active', !meta.hidden);
      cohortChart.update();
    });
    toggleEl.appendChild(btn);
  });
})();

// ─────────────────────────────────────────────
// PARTNER REVENUE % OF RILLET REVENUE
// ─────────────────────────────────────────────
(function() {
  const partnerArr = [130900, 105950, 55800, 146250, 153950];
  const rilletArr  = [679650, 1054750, 1495097.5, 1755140, 811150];
  const pct        = partnerArr.map((p,i) => +(p / rilletArr[i] * 100).toFixed(1));
  const ytdPct     = 10.2;

  new Chart(document.getElementById('partnerPctChart').getContext('2d'), {
    type: 'bar',
    data: {
      labels: MONTH_LABELS,
      datasets: [
        {
          type: 'bar',
          label: 'Partner % of Revenue',
          data: pct,
          backgroundColor: pct.map(v => v >= ytdPct ? 'rgba(99,102,241,0.8)' : 'rgba(99,102,241,0.4)'),
          borderColor: '#6366f1', borderWidth: 1,
          borderRadius: 4, order: 2,
        },
        {
          type: 'line',
          label: 'YTD Avg (10.2%)',
          data: MONTH_LABELS.map(() => ytdPct),
          borderColor: '#f59e0b', borderWidth: 2, borderDash: [6,4],
          pointRadius: 0, fill: false, tension: 0, order: 1,
        }
      ]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      interaction: { mode:'index', intersect:false },
      plugins: {
        legend: {
          display: true, position:'top', align:'end',
          labels: { color:'#94a3b8', font:{size:11}, boxWidth:20, padding:16 }
        },
        tooltip: {
          ...tooltipDefaults(),
          callbacks: {
            label: ctx => {
              if (ctx.datasetIndex === 1) return ` YTD avg: ${ctx.parsed.y}%`;
              const i = ctx.dataIndex;
              return [
                ` Partner: ${ctx.parsed.y}%`,
                ` $${(partnerArr[i]/1000).toFixed(0)}K of $${(rilletArr[i]/1000).toFixed(0)}K total`
              ];
            }
          }
        }
      },
      scales: {
        ...scaleDefaults(),
        y: { ...scaleDefaults().y, min:0, max:25, ticks:{ ...scaleDefaults().y.ticks, callback: v => v+'%' } }
      }
    }
  });
})();

// ─────────────────────────────────────────────
// REFERRAL ACTIVITY BAR CHART
// ─────────────────────────────────────────────
(function() {
  const data = [
    { label:"Jan '26", partners:6,  pct:6  },
    { label:"Feb '26", partners:25, pct:25 },
    { label:"Mar '26", partners:28, pct:28 },
    { label:"Apr '26", partners:39, pct:39 },
    { label:"May '26", partners:23, pct:23 },
  ];

  new Chart(document.getElementById('referralChart').getContext('2d'), {
    type: 'bar',
    data: {
      labels: data.map(d => d.label),
      datasets: [{
        label: '% of Partners Active',
        data: data.map(d => d.pct),
        backgroundColor: data.map(d => d.label === "Apr '26" ? 'rgba(99,102,241,0.85)' : 'rgba(99,102,241,0.4)'),
        borderColor:     data.map(d => d.label === "Apr '26" ? '#6366f1' : 'rgba(99,102,241,0.6)'),
        borderWidth: 1, borderRadius: 6,
      }]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: {
        legend: { display:false },
        tooltip: {
          ...tooltipDefaults(),
          callbacks: { label: ctx => ` ${ctx.parsed.y}% · ${data[ctx.dataIndex].partners} partners` }
        }
      },
      scales: {
        x: { ...scaleDefaults().x, grid:{ display:false } },
        y: { ...scaleDefaults().y, min:0, max:50, ticks:{ ...scaleDefaults().y.ticks, callback: v => v+'%' } }
      }
    }
  });
})();

